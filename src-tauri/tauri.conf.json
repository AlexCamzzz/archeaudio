{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ArcheAudio",
  "version": "0.1.0",
  "identifier": "com.archeaudio.dev",
  "build": {
    "frontendDist": "./src/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArcheAudio",
        "width": 950,
        "height": 550,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
